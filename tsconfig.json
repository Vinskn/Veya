{
  "compilerOptions": {
    "target": "ES2022",                         
    "module": "esnext",                        
    "moduleResolution": "bundler",
    "outDir": "./dist",                          
    "rootDir": "./",                             
    "strict": true,                              
    "esModuleInterop": true,                      
    "skipLibCheck": true,                        
    "forceConsistentCasingInFileNames": true
  },
  "include": ["server.ts", "**/*.ts"],           
  "exclude": ["node_modules"]
}